<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Harness.WinUI.Panes.BrowserPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Harness.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        BorderThickness="1,0,0,0"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Padding="16,8,8,8"
            ColumnSpacing="8"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    Text="{x:Bind app:Strings.BrowserPaneTitle}" />
                <TextBlock
                    x:Name="AddressText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    AutomationProperties.AutomationId="BrowserPaneAddress" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Padding="8"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.AutomationId="BrowserPaneCloseButton"
                AutomationProperties.Name="{x:Bind app:Strings.BrowserPaneClose}"
                ToolTipService.ToolTip="{x:Bind app:Strings.BrowserPaneClose}"
                Click="Close_Click">
                <FontIcon FontSize="14" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- The browser itself is created for each run (a closed WebView2 cannot be reused) and put here. -->
        <Grid x:Name="Host" Grid.Row="1" />
    </Grid>
</UserControl>
