<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Harness.WinUI.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Harness.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind local:Strings.SettingsTitle}"
    PrimaryButtonText="{x:Bind local:Strings.Save}"
    CloseButtonText="{x:Bind local:Strings.Cancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="SettingsDialog_PrimaryButtonClick"
    mc:Ignorable="d">

    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="360" MaxWidth="460" Spacing="12" Padding="0,0,12,0">

            <!-- Language -->
            <TextBlock Text="{x:Bind local:Strings.LanguageHeader}" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ComboBox
                x:Name="LanguageComboBox"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="SettingsLanguageComboBox"
                AutomationProperties.Name="{x:Bind local:Strings.LanguageHeader}">
                <ComboBoxItem Content="{x:Bind local:Strings.LanguageSystem}" Tag="system" />
                <ComboBoxItem Content="English" Tag="en" />
                <ComboBoxItem Content="繁體中文" Tag="zh-TW" />
            </ComboBox>
            <TextBlock
                Text="{x:Bind local:Strings.LanguageRestartNote}"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <!-- Model provider -->
            <TextBlock Margin="0,8,0,0" Text="{x:Bind local:Strings.ProviderHeader}" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="{x:Bind local:Strings.ProviderIntro}"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <TextBox
                x:Name="EndpointTextBox"
                Header="{x:Bind local:Strings.Endpoint}"
                AutomationProperties.AutomationId="SettingsEndpointTextBox"
                PlaceholderText="https://your-resource.openai.azure.com/openai/v1"
                TextWrapping="Wrap"
                TextChanged="Field_Changed" />

            <TextBox
                x:Name="ModelTextBox"
                Header="{x:Bind local:Strings.Model}"
                AutomationProperties.AutomationId="SettingsModelTextBox"
                PlaceholderText="gpt-4o-mini"
                TextChanged="Field_Changed" />

            <TextBox
                x:Name="ImageModelTextBox"
                Header="{x:Bind local:Strings.ImageModel}"
                AutomationProperties.AutomationId="SettingsImageModelTextBox"
                PlaceholderText="{x:Bind local:Strings.ImageModelPlaceholder}" />

            <PasswordBox
                x:Name="ApiKeyPasswordBox"
                Header="{x:Bind local:Strings.ApiKey}"
                AutomationProperties.AutomationId="SettingsApiKeyPasswordBox"
                PasswordRevealMode="Peek"
                PasswordChanged="Field_Changed" />

            <ComboBox
                x:Name="ApiComboBox"
                Header="{x:Bind local:Strings.ApiType}"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="SettingsApiComboBox">
                <ComboBoxItem Content="{x:Bind local:Strings.ApiAuto}" Tag="Auto" />
                <ComboBoxItem Content="Responses" Tag="Responses" />
                <ComboBoxItem Content="Chat Completions" Tag="ChatCompletions" />
            </ComboBox>
            <TextBlock
                Text="{x:Bind local:Strings.ApiHelp}"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <!-- Sandbox folder -->
            <TextBlock Margin="0,8,0,0" Text="{x:Bind local:Strings.SandboxHeader}" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SandboxTextBox"
                    AutomationProperties.AutomationId="SettingsSandboxTextBox"
                    AutomationProperties.Name="{x:Bind local:Strings.SandboxHeader}"
                    PlaceholderText="{x:Bind local:Strings.SandboxNone}"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Content="{x:Bind local:Strings.Browse}"
                    AutomationProperties.AutomationId="SettingsSandboxBrowseButton"
                    Click="BrowseSandbox_Click" />
            </Grid>
            <TextBlock
                Text="{x:Bind local:Strings.SandboxHelp}"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <TextBlock
                x:Name="ErrorTextBlock"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
