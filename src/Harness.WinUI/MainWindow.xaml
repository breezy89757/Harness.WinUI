<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Harness.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Harness.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:artifacts="using:Harness.WinUI.Artifacts"
    xmlns:vm="using:Harness.WinUI.ViewModels"
    xmlns:agent="using:Harness.Core.Agent"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ChatColumn" Width="*" MinWidth="360" />
            <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
            <ColumnDefinition x:Name="ArtifactColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- Chat -->
        <Grid x:Name="ChatGrid" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Chat or Code (Code mode is a coding agent in a project folder), the folder, and the modes that change what the agent may do. -->
            <Border
                x:Name="ModeBar"
                Grid.Row="0"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid Padding="16,6,16,6" MinHeight="46" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:SelectorBar
                        x:Name="ModeSelector"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ModeSelector"
                        AutomationProperties.Name="{x:Bind local:Strings.ModeSelectorName}"
                        SelectionChanged="ModeSelector_SelectionChanged">
                        <controls:SelectorBarItem x:Name="ChatModeItem" Tag="chat" Text="{x:Bind local:Strings.ModeChat}">
                            <controls:SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE8BD;" />
                            </controls:SelectorBarItem.Icon>
                        </controls:SelectorBarItem>
                        <controls:SelectorBarItem x:Name="CodeModeItem" Tag="code" Text="{x:Bind local:Strings.ModeCode}">
                            <controls:SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE943;" />
                            </controls:SelectorBarItem.Icon>
                        </controls:SelectorBarItem>
                    </controls:SelectorBar>

                    <!-- The project folder Code mode works in: pick another, or one used before. -->
                    <Button
                        x:Name="WorkspaceButton"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Padding="12,5"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        AutomationProperties.AutomationId="WorkspaceButton"
                        AutomationProperties.Name="{x:Bind local:Strings.WorkspaceButtonName}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                            <TextBlock x:Name="WorkspaceText" MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <FontIcon FontSize="10" Glyph="&#xE70D;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="WorkspaceFlyout" Placement="BottomEdgeAlignedLeft" Opening="WorkspaceFlyout_Opening" />
                        </Button.Flyout>
                    </Button>

                    <!-- Shown only while a mode that changes what the agent may do is on; a click turns it off. -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            x:Name="ReadOnlyBadge"
                            Visibility="Collapsed"
                            Padding="10,3"
                            CornerRadius="12"
                            AutomationProperties.AutomationId="ReadOnlyBadge"
                            Click="ReadOnlyBadge_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE72E;" />
                                <TextBlock Text="{x:Bind local:Strings.ReadOnlyBadge}" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="YoloBadge"
                            Visibility="Collapsed"
                            Padding="10,3"
                            CornerRadius="12"
                            Background="{ThemeResource SystemFillColorCriticalBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            AutomationProperties.AutomationId="YoloBadge"
                            Click="YoloBadge_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE7BA;" Foreground="White" />
                                <TextBlock Text="YOLO" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <controls:WebView2
                x:Name="ChatWebView"
                Grid.Row="1"
                AutomationProperties.Name="{x:Bind local:Strings.ChatTranscript}" />

            <!-- Text size feedback (Ctrl + / - / 0, Ctrl + wheel): fades in, then out. -->
            <Border
                x:Name="ZoomIndicator"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                Padding="16,8"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                Opacity="0"
                IsHitTestVisible="False">
                <TextBlock x:Name="ZoomIndicatorText" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Border>

            <!-- Skills to pick from while the message starts with "/". Focus stays in the message box; arrow keys and Enter/Tab drive it. -->
            <Border
                x:Name="SkillSuggestions"
                Grid.Row="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="24,0,24,8"
                MinWidth="320"
                MaxWidth="560"
                Padding="4"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="Collapsed">
                <ListView
                    x:Name="SkillList"
                    MaxHeight="240"
                    SelectionMode="Single"
                    IsTabStop="False"
                    IsItemClickEnabled="True"
                    ItemClick="SkillList_ItemClick"
                    AutomationProperties.AutomationId="SkillSuggestionList"
                    AutomationProperties.Name="{x:Bind local:Strings.SkillSuggestions}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SkillSuggestion">
                            <StackPanel Padding="0,4" Spacing="2">
                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind Description}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Pasted / dropped attachments, sent with the next message. -->
            <!-- Code mode: the agent's task list, kept by update_tasks. -->
            <StackPanel Grid.Row="2">
            <!-- Code mode: the helper agents that are working (spawn_agent), one card each. -->
            <Border
                x:Name="HelperPanel"
                Padding="24,8,24,8"
                Visibility="Collapsed"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="HelperHeaderText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel x:Name="HelperCardsPanel" Spacing="6" />
                </StackPanel>
            </Border>
            <Border
                x:Name="TaskPanel"
                Padding="24,8,24,8"
                Visibility="Collapsed"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <Button
                        x:Name="TaskHeaderButton"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="TaskHeaderButton"
                        Click="TaskHeaderButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="TaskChevron" FontSize="10" Glyph="&#xE70D;" />
                            <TextBlock x:Name="TaskHeaderText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                    </Button>
                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TaskItemsPanel" Spacing="2" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
            </StackPanel>

            <Border
                x:Name="AttachmentStrip"
                Grid.Row="3"
                Padding="24,10,24,0"
                Visibility="Collapsed"
                AllowDrop="True"
                DragOver="Composer_DragOver"
                Drop="Composer_Drop"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <ItemsControl x:Name="AttachmentList" AutomationProperties.Name="{x:Bind local:Strings.Attachments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="agent:Attachment">
                            <Grid
                                Height="56"
                                Padding="6"
                                ColumnSpacing="8"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                ToolTipService.ToolTip="{x:Bind Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Width="44"
                                    Height="44"
                                    Stretch="UniformToFill"
                                    Source="{x:Bind local:MainWindow.Thumbnail(Image)}"
                                    Visibility="{x:Bind IsImage}" />
                                <FontIcon FontSize="20" Glyph="&#xE8A5;" Visibility="{x:Bind local:MainWindow.CollapsedWhen(IsImage)}" />
                                <TextBlock
                                    Grid.Column="1"
                                    MaxWidth="160"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Name}" />
                                <Button
                                    Grid.Column="2"
                                    Padding="4"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Tag="{x:Bind}"
                                    AutomationProperties.Name="{x:Bind local:Strings.RemoveAttachment}"
                                    ToolTipService.ToolTip="{x:Bind local:Strings.RemoveAttachment}"
                                    Click="RemoveAttachment_Click">
                                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid
                x:Name="ComposerGrid"
                Grid.Row="4"
                AllowDrop="True"
                DragOver="Composer_DragOver"
                Drop="Composer_Drop"
                ColumnSpacing="12"
                Padding="24,16,24,20"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Toolbar: the user picks which buttons show (right-click it, or More › Customize);
                     hidden ones are in the More menu. -->
                <StackPanel
                    x:Name="ToolbarPanel"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    ContextRequested="ToolbarPanel_ContextRequested">
                    <Button
                        x:Name="NewChatButton"
                        AutomationProperties.AutomationId="NewChatButton"
                        AutomationProperties.Name="{x:Bind local:Strings.NewChat}"
                        VerticalAlignment="Bottom"
                        Padding="10,8"
                        ToolTipService.ToolTip="{x:Bind local:Strings.NewChatTooltip}"
                        Command="{x:Bind ViewModel.NewChatCommand}">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                    </Button>

                    <Button
                        x:Name="HistoryButton"
                        AutomationProperties.AutomationId="HistoryButton"
                        AutomationProperties.Name="{x:Bind local:Strings.History}"
                        VerticalAlignment="Bottom"
                        Padding="10,8"
                        ToolTipService.ToolTip="{x:Bind local:Strings.HistoryTooltip}"
                        IsEnabled="{x:Bind local:MainWindow.IsNotBusy(ViewModel.IsBusy), Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="&#xE81C;" />
                        <Button.Flyout>
                            <Flyout x:Name="HistoryFlyout" Placement="TopEdgeAlignedLeft" Opening="HistoryFlyout_Opening">
                                <Grid Width="360" MaxHeight="480" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{x:Bind local:Strings.History}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBox
                                        x:Name="HistorySearchBox"
                                        Grid.Row="1"
                                        MaxLength="100"
                                        AutomationProperties.AutomationId="HistorySearchBox"
                                        AutomationProperties.Name="{x:Bind local:Strings.HistorySearchPlaceholder}"
                                        PlaceholderText="{x:Bind local:Strings.HistorySearchPlaceholder}"
                                        TextChanged="HistorySearchBox_TextChanged" />
                                    <TextBlock
                                        x:Name="HistoryEmptyText"
                                        Grid.Row="2"
                                        Text="{x:Bind local:Strings.NoHistory}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ListView
                                        x:Name="HistoryList"
                                        Grid.Row="2"
                                        AutomationProperties.AutomationId="HistoryList"
                                        AutomationProperties.Name="{x:Bind local:Strings.History}"
                                        ItemsSource="{x:Bind ViewModel.History}"
                                        SelectionMode="None"
                                        IsItemClickEnabled="True"
                                        ItemClick="HistoryList_ItemClick">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ConversationItem">
                                                <Grid Padding="0,6" ColumnSpacing="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsCurrent}" />
                                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Text="{x:Bind When}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        Padding="6"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="{x:Bind MoreLabel}"
                                                        AutomationProperties.Name="{x:Bind MoreLabel}">
                                                        <FontIcon FontSize="12" Glyph="&#xE712;" />
                                                        <Button.Flyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="{x:Bind RenameLabel}" Tag="{x:Bind}" Click="RenameConversation_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE70F;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="{x:Bind ExportLabel}" Tag="{x:Bind}" Click="ExportConversation_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE78C;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                    <Button
                                                        Grid.Column="2"
                                                        Padding="6"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Tag="{x:Bind Id}"
                                                        ToolTipService.ToolTip="{x:Bind DeleteLabel}"
                                                        AutomationProperties.Name="{x:Bind DeleteLabel}"
                                                        Click="DeleteConversation_Click">
                                                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Name="SettingsButton"
                        AutomationProperties.AutomationId="SettingsButton"
                        AutomationProperties.Name="{x:Bind local:Strings.SettingsTooltip}"
                        VerticalAlignment="Bottom"
                        Padding="10,8"
                        ToolTipService.ToolTip="{x:Bind local:Strings.SettingsTooltip}"
                        Click="SettingsButton_Click">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                    </Button>

                    <Button
                        x:Name="ToolsButton"
                        AutomationProperties.AutomationId="ToolsButton"
                        AutomationProperties.Name="{x:Bind local:Strings.ToolsTooltip}"
                        VerticalAlignment="Bottom"
                        Padding="10,8"
                        ToolTipService.ToolTip="{x:Bind ViewModel.McpStatusText, Mode=OneWay}"
                        Click="ToolsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="16" Glyph="&#xE90F;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.McpBadgeText, Mode=OneWay}" />
                            <FontIcon
                                FontSize="12"
                                Glyph="&#xE7BA;"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Visibility="{x:Bind ViewModel.McpHasErrors, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <ToggleButton
                        x:Name="ReadOnlyButton"
                        AutomationProperties.AutomationId="ReadOnlyButton"
                        AutomationProperties.Name="{x:Bind local:Strings.ReadOnlyMode}"
                        VerticalAlignment="Bottom"
                        Padding="10,8"
                        ToolTipService.ToolTip="{x:Bind local:Strings.ReadOnlyTooltipOff}"
                        Click="ReadOnlyButton_Click">
                        <FontIcon FontSize="16" Glyph="&#xE72E;" />
                    </ToggleButton>

                    <ToggleButton
                        x:Name="YoloButton"
                        AutomationProperties.AutomationId="YoloButton"
                        AutomationProperties.Name="{x:Bind local:Strings.YoloMode}"
                        VerticalAlignment="Bottom"
                        Padding="10,8"
                        ToolTipService.ToolTip="{x:Bind local:Strings.YoloTooltipOff}"
                        Click="YoloButton_Click">
                        <ToggleButton.Resources>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#C42B1C" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#D13438" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#A4262C" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White" />
                        </ToggleButton.Resources>
                        <FontIcon FontSize="16" Glyph="&#xE7BA;" />
                    </ToggleButton>

                    <Button
                        x:Name="QualityButton"
                        AutomationProperties.AutomationId="QualityButton"
                        AutomationProperties.Name="{x:Bind local:Strings.ResponseQuality}"
                        VerticalAlignment="Bottom"
                        Padding="10,8">
                        <FontIcon FontSize="16" Glyph="&#xE945;" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="QualityFlyout" Placement="TopEdgeAlignedLeft" Opening="QualityFlyout_Opening">
                                <ToggleMenuFlyoutItem x:Name="WebSearchItem" Text="{x:Bind local:Strings.WebSearch}" Click="WebSearch_Click">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE774;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="{x:Bind local:Strings.ReasoningEffortHeader}" IsEnabled="False" />
                                <RadioMenuFlyoutItem x:Name="EffortAuto" GroupName="Effort" Tag="auto" Text="{x:Bind local:Strings.EffortAuto}" Click="Effort_Click" />
                                <RadioMenuFlyoutItem x:Name="EffortLow" GroupName="Effort" Tag="low" Text="{x:Bind local:Strings.EffortLow}" Click="Effort_Click" />
                                <RadioMenuFlyoutItem x:Name="EffortMedium" GroupName="Effort" Tag="medium" Text="{x:Bind local:Strings.EffortMedium}" Click="Effort_Click" />
                                <RadioMenuFlyoutItem x:Name="EffortHigh" GroupName="Effort" Tag="high" Text="{x:Bind local:Strings.EffortHigh}" Click="Effort_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="{x:Bind local:Strings.ImageQualityHeader}" IsEnabled="False" />
                                <RadioMenuFlyoutItem x:Name="ImageLow" GroupName="Image" Tag="low" Text="{x:Bind local:Strings.ImageLow}" Click="ImageQuality_Click" />
                                <RadioMenuFlyoutItem x:Name="ImageMedium" GroupName="Image" Tag="medium" Text="{x:Bind local:Strings.ImageMedium}" Click="ImageQuality_Click" />
                                <RadioMenuFlyoutItem x:Name="ImageHigh" GroupName="Image" Tag="high" Text="{x:Bind local:Strings.ImageHigh}" Click="ImageQuality_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Name="UsageButton"
                        AutomationProperties.AutomationId="UsageButton"
                        AutomationProperties.Name="{x:Bind local:Strings.UsageTooltip}"
                        VerticalAlignment="Bottom"
                        Padding="10,8"
                        ToolTipService.ToolTip="{x:Bind local:Strings.UsageTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="16" Glyph="&#xE8EF;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ConversationCostText, Mode=OneWay}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedLeft" Opening="UsageFlyout_Opening">
                                <Grid x:Name="UsageGrid" MinWidth="300" ColumnSpacing="16" RowSpacing="10" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Name="ObservabilityButton"
                        AutomationProperties.AutomationId="ObservabilityButton"
                        AutomationProperties.Name="{x:Bind local:Strings.ObservabilityTitle}"
                        VerticalAlignment="Bottom"
                        Padding="10,8"
                        ToolTipService.ToolTip="{x:Bind local:Strings.ObservabilityTooltip}"
                        Click="ObservabilityButton_Click">
                        <FontIcon FontSize="16" Glyph="&#xE9D9;" />
                    </Button>

                    <Button
                        x:Name="MemoryButton"
                        AutomationProperties.AutomationId="MemoryButton"
                        AutomationProperties.Name="{x:Bind local:Strings.MemoryTitle}"
                        VerticalAlignment="Bottom"
                        Padding="10,8"
                        ToolTipService.ToolTip="{x:Bind local:Strings.MemoryTitle}"
                        Click="MemoryButton_Click">
                        <FontIcon FontSize="16" Glyph="&#xE8F1;" />
                    </Button>

                    <Button
                        x:Name="MoreButton"
                        AutomationProperties.AutomationId="MoreButton"
                        AutomationProperties.Name="{x:Bind local:Strings.MoreTooltip}"
                        VerticalAlignment="Bottom"
                        Padding="10,8"
                        ToolTipService.ToolTip="{x:Bind local:Strings.MoreTooltip}">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="MoreFlyout" Placement="TopEdgeAlignedLeft" Opening="MoreFlyout_Opening" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <TextBox
                    x:Name="InputTextBox"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="ChatInputTextBox"
                    AutomationProperties.Name="{x:Bind local:Strings.MessageInput}"
                    PlaceholderText="{x:Bind local:Strings.MessagePlaceholder}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MaxHeight="160"
                    VerticalAlignment="Bottom"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{x:Bind local:MainWindow.IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                    TextChanged="InputTextBox_TextChanged"
                    PreviewKeyDown="InputTextBox_PreviewKeyDown"
                    Paste="InputTextBox_Paste"
                    TextCompositionStarted="InputTextBox_TextCompositionStarted"
                    TextCompositionEnded="InputTextBox_TextCompositionEnded" />

                <Button
                    x:Name="SendButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="SendButton"
                    AutomationProperties.Name="{x:Bind local:Strings.SendMessage}"
                    Content="{x:Bind local:Strings.Send}"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Bottom"
                    MinWidth="88"
                    Visibility="{x:Bind local:MainWindow.CollapsedWhen(ViewModel.IsBusy), Mode=OneWay}"
                    Command="{x:Bind ViewModel.SendCommand}" />

                <Button
                    x:Name="StopButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="StopButton"
                    AutomationProperties.Name="{x:Bind local:Strings.Stop}"
                    ToolTipService.ToolTip="{x:Bind local:Strings.StopTooltip}"
                    VerticalAlignment="Bottom"
                    MinWidth="88"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Command="{x:Bind ViewModel.StopCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE71A;" />
                        <TextBlock Text="{x:Bind local:Strings.Stop}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Artifact panel (collapsed until the first artifact) -->
        <toolkit:GridSplitter
            x:Name="ArtifactSplitter"
            Grid.Column="1"
            Width="6"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            Visibility="Collapsed" />

        <artifacts:ArtifactPanel
            x:Name="ArtifactPanel"
            Grid.Column="2"
            Visibility="Collapsed"
            OpenRequested="ArtifactPanel_OpenRequested"
            CloseRequested="ArtifactPanel_CloseRequested" />
    </Grid>
</Window>
