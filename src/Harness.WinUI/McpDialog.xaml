<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Harness.WinUI.McpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Harness.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind local:Strings.McpTitle}"
    CloseButtonText="{x:Bind local:Strings.Done}"
    DefaultButton="None"
    mc:Ignorable="d">

    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="480" Spacing="12" Padding="0,0,12,0">
            <TextBlock
                Text="{x:Bind local:Strings.McpIntro}"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock
                x:Name="EmptyText"
                Text="{x:Bind local:Strings.McpEmpty}"
                TextWrapping="Wrap"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <ItemsControl x:Name="ServerList" AutomationProperties.Name="{x:Bind local:Strings.McpServerList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:McpServerRow">
                        <Grid
                            Margin="0,0,0,8"
                            Padding="12,10"
                            ColumnSpacing="12"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{x:Bind StateBrush}" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind Summary}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    ToolTipService.ToolTip="{x:Bind Summary}" />
                                <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>

                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                OnContent=""
                                OffContent=""
                                IsOn="{x:Bind Enabled}"
                                Tag="{x:Bind Name}"
                                AutomationProperties.Name="{x:Bind local:Strings.Enabled}"
                                Toggled="Enabled_Toggled" />

                            <Button
                                Grid.Column="3"
                                Padding="8"
                                VerticalAlignment="Center"
                                Tag="{x:Bind Name}"
                                AutomationProperties.Name="{x:Bind local:Strings.RemoveServer}"
                                ToolTipService.ToolTip="{x:Bind local:Strings.Remove}"
                                Click="RemoveButton_Click">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{x:Bind local:Strings.AddRemoteServer}" Style="{StaticResource BodyStrongTextBlockStyle}" />

            <TextBox x:Name="NameTextBox" Header="{x:Bind local:Strings.Name}" PlaceholderText="mslearn" AutomationProperties.AutomationId="McpNameTextBox" />
            <TextBox x:Name="UrlTextBox" Header="{x:Bind local:Strings.Url}" PlaceholderText="https://learn.microsoft.com/api/mcp" AutomationProperties.AutomationId="McpUrlTextBox" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="HeaderNameTextBox"
                    Header="{x:Bind local:Strings.AuthHeader}"
                    PlaceholderText="Authorization"
                    AutomationProperties.AutomationId="McpHeaderNameTextBox" />
                <PasswordBox
                    x:Name="HeaderValueBox"
                    Grid.Column="1"
                    Header="{x:Bind local:Strings.HeaderValue}"
                    PlaceholderText="Bearer …"
                    PasswordRevealMode="Peek"
                    AutomationProperties.AutomationId="McpHeaderValueBox" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="AddButton"
                    Content="{x:Bind local:Strings.AddAndConnect}"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="McpAddButton"
                    Click="Add_Click" />
                <ProgressRing x:Name="AddProgress" Width="20" Height="20" IsActive="False" />
            </StackPanel>

            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Visibility="Collapsed" />

            <TextBlock
                Text="{x:Bind local:Strings.HeaderEncryptedNote}"
                TextWrapping="Wrap"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="16">
                <HyperlinkButton Padding="0" Content="{x:Bind local:Strings.EditMcpJson}" Click="EditJson_Click" />
                <HyperlinkButton Padding="0" Content="{x:Bind local:Strings.ReloadFromFile}" Click="Reload_Click" />
            </StackPanel>

            <!-- Skills (Agent Skills: folders with a SKILL.md) -->
            <TextBlock Margin="0,12,0,0" Text="{x:Bind local:Strings.SkillsHeader}" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="{x:Bind local:Strings.SkillsIntro}"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="SkillList" Spacing="8" AutomationProperties.Name="{x:Bind local:Strings.SkillsHeader}" />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <HyperlinkButton Padding="0" Content="{x:Bind local:Strings.OpenSkillsFolder}" Click="OpenSkillsFolder_Click" />
                <HyperlinkButton Padding="0" Content="{x:Bind local:Strings.Refresh}" Click="RefreshSkills_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
