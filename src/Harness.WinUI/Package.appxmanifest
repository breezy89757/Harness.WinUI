<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build. The project itself builds unpackaged for development;
  packaging is done from the Release output (see build-msix.ps1).
  Identity, publisher and display name come from Partner Center (Product identity) for the reserved
  name "Harness.WinUI" (Store ID 9PFS9CGGK7VB); the Store rejects packages whose identity differs.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap com desktop">

  <Identity
    Name="breezy89757.Harness.WinUI"
    Publisher="CN=A3963833-22D8-4E83-930F-BC52A2A4B1C0"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Harness.WinUI</DisplayName>
    <PublisherDisplayName>breezy89757</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <!-- The languages Harness.WinUI's UI and Store listings are in. Not x-generate: the self-contained
         Windows App SDK brings WinUI's strings in 86 languages into resources.pri, which would make the
         package (and its Store page) claim all of them. WinUI's own text (menus, tooltips) follows these. -->
    <Resource Language="en-US" />
    <Resource Language="zh-TW" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="Harness.WinUI.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Harness.WinUI"
        Description="Harness.WinUI — a lightweight AI agent for Windows."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>
      <!-- App notifications (finished replies, pending approvals): the activator Windows calls when one is clicked. -->
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Harness.WinUI.exe" DisplayName="Harness.WinUI" Arguments="----AppNotificationActivated:">
              <com:Class Id="1AE32632-C96D-4599-83B8-F544310D49C6" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="1AE32632-C96D-4599-83B8-F544310D49C6" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
